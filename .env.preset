# ══════════════════════════════════════════════════════════════
# 铃兰桌宠 —— **出厂预设的环境变量**（随包发布，程序首启会复制成 .env）
#
# ★ 这份文件是**故意进版本库/随包**的（用户 2026-10-05 拍板"选 C"：
#   "这部分key作为出厂默认预设。熟人使用的小项目，不担心被刷爆。"）。
#   目的：熟人拿到就能直接用**天气 / 联网搜索 / 终末地**，
#   不必自己去注册这三个服务。
#
# ★ **不含 LLM 的 Key** —— 那个每个用户自己填（首次启动的配置引导会问），
#   填好后写进**他自己的** `.env`（不进版本库）。
#
# ★ 由 `python tools/make_preset_env.py` 从开发机的 `.env` 里**挑白名单键**生成，
#   不手抄（手抄迟早漏/写错）。要加键请改那个脚本里的 PRESET_KEYS 并写明理由。
# ══════════════════════════════════════════════════════════════

# 和风天气的专属 Host（注册后控制台可见）
WEATHER_API_HOST=p37byj4xwf.re.qweatherapi.com

# 和风天气 KEY
WEATHER_API_KEY=70cd57cbf5924c628d788d67cbbe3f36

# 联网搜索 KEY
TAVILY_API_KEY=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

# 联网搜索接口（一般不用改）
TAVILY_API_URL=https://api.tavily.com/search

# 终末地 KEY
ENDFIELD_API_KEY=ef_5366d0385fc5790cf77ef6fb83fc1b8607af307ec81030f0d0a9c33c3d57cba1

# 终末地接口
ENDFIELD_API_BASEURL=https://end-api.shallow.ink/

# ComfyUI 主机（通用默认）
COMFYUI_HOST=127.0.0.1

# ComfyUI 端口（通用默认）
COMFYUI_PORT=8188

# ★ 必须保持 0（设 1 会让形象窗口永久不可见，见 .env.example）
PRTS_PET_COMPOSITED=0

# ── 以下这些**故意不预设**（写了原因，别照抄进来）──
# DEEPSEEK_API_KEY    —— 引导会问用户；而且它是要花钱的那个
# PIXIV_REFRESH_TOKEN —— 会过期，预设也是废的
# PIXIV_PROXY         —— 机器相关（本机代理端口）
# COMFYUI_PATH        —— 机器相关（绝对路径）
