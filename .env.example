# ══════════════════════════════════════════════════════════════
# PTRTS 桌宠 —— 环境变量模板
#
# ★ 真正的密钥在 `.env`（**已被 .gitignore 排除，不进版本库**）。
#   换机器 / 重新 clone 之后：把本文件复制成 `.env`，再把值填上。
#   生成方式：`copy .env.example .env`（cmd）或
#             `Copy-Item .env.example .env`（PowerShell）
# ══════════════════════════════════════════════════════════════

# ---- LLM（DeepSeek）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ---- 天气（和风天气 QWeather）----
#   专属 API Host（形如 xxxxxx.re.qweatherapi.com），在控制台能看到
WEATHER_API_HOST=
WEATHER_API_KEY=

# ---- 联网搜索（Tavily）----
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# ---- 终末地（森空岛/终末地助手）----
ENDFIELD_API_KEY=
ENDFIELD_API_BASEURL=

# ---- Pixiv ----
#   refresh token 会过期，过期后重新走一次 OAuth 拿新的
PIXIV_REFRESH_TOKEN=
PIXIV_PROXY=

# ---- 本机 ComfyUI（画图工具用）----
COMFYUI_PATH=D:\Apps\ComfyUI_windows_portable_nvidia\ComfyUI_windows_portable
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ---- ★ 形象窗口透明方案开关（1.9.2）----
#   1（默认）= 色键透明（根治"形象消失"的那个机制问题）
#   0        = 退回旧的逐像素 alpha 分层窗口
#   如果形象出现品红描边或整块不见 → 设成 0
PRTS_PET_COLORKEY=1

# ---- 形象窗口 WS_EX_COMPOSITED（★ 实测会把分层窗口弄坏，保持 0）----
PRTS_PET_COMPOSITED=0
