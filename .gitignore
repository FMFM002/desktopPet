# ══════════════════════════════════════════════════════════════
# PTRTS 桌宠 —— .gitignore
# ★ 1.9.2 建立（用户要求"开始使用 git 控制版本"）
#
# 原则：
#   · **代码全部入库**（src / tools / main.py / 文档 / 测试）
#   · **大体积二进制与模型不入库**（几 GB，且可重新下载）
#   · **密钥绝不入库**（.env 含 DeepSeek/Pixiv/天气 等 key）
#   · 日志、缓存、临时物不入库
# ══════════════════════════════════════════════════════════════

# ---- 密钥（★ 绝不入库：.env 里有 API key / token）----
.env
.env.*
!.env.example

# ---- TTS 模型权重（src/genie_tts/assets 共约 1.86 GB）----
#   onnx / bin 都是大模型文件，可重新下载，不进版本库
src/genie_tts/assets/**/*.onnx
src/genie_tts/assets/**/*.bin
src/genie_tts/assets/**/*.pth
src/genie_tts/assets/**/*.pt
src/genie_tts/assets/**/*.ckpt

# ---- 其它模型 / 大资源 ----
data/models/
data/whisper/
data/downloads/
data/cookies/
data/DBs/
data/桌宠私有data/

# ---- 日志 ----
logs/
*.log

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---- 备份文件（1.9.2 起用 git 兜底，不再需要一堆 .bak）----
*.bak
*.bak-*
*.bak2

# ---- 测试临时库 / 编辑器 ----
_test_tmp_dbs/
.idea/
.vscode/
*.swp

# ---- 本机应用路径记忆（★ 1.9.2 app_launcher，因机器而异，不进版本库）----
data/app_paths.json

# ---- ★ 1.9.2 BT 引擎（aria2c，11MB 第三方二进制，不进版本库）----
#   为什么忽略：11MB 的第三方 exe 进 git 历史不划算，而它**可校验复原** ——
#   来源、tag、压缩包与二进制的两个 sha256 都记在
#   data/tools/aria2c.SOURCE.txt 里（取自参考项目 Motrix 的
#   scripts/engine.lock.json，不是我算的）。
#   复原办法：python tools/fetch_aria2.py  （会下载 + 双校验 + 装到位）
#   ★ 注意：官方 aria2-1.37.0-win-64bit-build1 **不能用** —— 它是
#     mingw+WinTLS 构建，在本机上所有 HTTPS 都失败
#     （[WinTLSContext.cc:188] Failed to initialize WinTLS context handle），
#     导致 https tracker 全废。必须用 Motrix 那个 OpenSSL 构建。
data/tools/*.exe
#   CA 证书包（236KB）**要入库**：OpenSSL 版 aria2 没它连不上 https tracker
!data/tools/cacert.pem
!data/tools/aria2c.SOURCE.txt

# ---- 系统 ----
Thumbs.db
desktop.ini

# 回归的配置保镖快照（跑完自动删；内含用户真实 config.json/.env，绝不入库）
tools/dev_tests/_cfg_guard/

# 回归的临时产物（每次都重写，入库只会制造无意义的 diff；它们都能重新生成）
tools/dev_tests/_persist_bak/
tools/dev_tests/_winsize_bak/
tools/dev_tests/_sweep_out/

# 粘贴图的磁盘缓存（WebP，运行时自动生成/自动淘汰，不入库）
data/chat_clips/

# 聊天显示用的 648 预览缓存（WebP，运行时自动生成/自动淘汰，不入库）
data/chat_previews/
