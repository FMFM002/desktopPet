# ══════════════════════════════════════════════════════════════
# PTRTS 桌宠 —— 环境变量模板
#
# ★ 真正的密钥在 `.env`（**已被 .gitignore 排除，不进版本库**）。
#   换机器 / 重新 clone 之后：把本文件复制成 `.env`，再把值填上。
#   生成方式：`copy .env.example .env`（cmd）或
#             `Copy-Item .env.example .env`（PowerShell）
# ══════════════════════════════════════════════════════════════

# ---- LLM（DeepSeek）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ---- 天气（和风天气 QWeather）----
#   专属 API Host（形如 xxxxxx.re.qweatherapi.com），在控制台能看到
WEATHER_API_HOST=
WEATHER_API_KEY=

# ---- 联网搜索（Tavily）----
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# ---- 终末地（森空岛/终末地助手）----
ENDFIELD_API_KEY=
ENDFIELD_API_BASEURL=

# ---- ★ 代理（1.9.2：BT 与 P站/JM 的"VPN 冲突"方案）----
#   背景：P站/JM 需要代理；而 BT 的 peer 连接**协议层不支持代理**
#   （aria2 的代理选项只管 HTTP/HTTPS/FTP），且代理出口是机房 IP，
#   tracker 会直接拒 → BT 必须直连。两者不能共用同一条出口。
#
#   所以本项目用**应用级分流**，不再依赖系统级 VPN：
#     · P站 / JM 工具 → 走下面这个本地代理端口
#     · aria2c（BT）  → 强制直连（会清掉代理环境变量 + --all-proxy=）
#   在代理客户端里配一条规则分流("PROCESS-NAME,aria2c.exe,DIRECT" 等)
#   就能"开着代理也能下 BT"，不用再手动开关 VPN。
#   详见 src/core/net_proxy.py 的说明。
#
#   PRTS_PROXY 是通用项；没配时兼容读取下面的 PIXIV_PROXY。
#   例：http://127.0.0.1:7890 （Clash 默认端口）或 socks5://127.0.0.1:1080
PRTS_PROXY=

# ---- Pixiv ----
#   refresh token 会过期，过期后重新走一次 OAuth 拿新的
PIXIV_REFRESH_TOKEN=
# 兼容旧名：没设 PRTS_PROXY 时用它
PIXIV_PROXY=

# ---- 本机 ComfyUI（画图工具用）----
COMFYUI_PATH=D:\Apps\ComfyUI_windows_portable_nvidia\ComfyUI_windows_portable
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ---- ★ 形象窗口透明方案（1.9.2）----
#   ⚠ PRTS_PET_COLORKEY（色键透明）已于 2026-09-18 19:15 **用户拍板回退并从代码里
#     删干净**：真机三连败（品红描边 / 形象消失且不回来 / 还是抽），
#     最终回到"逐像素 alpha 分层窗口 + 两种场景都能自愈"的备份方案。
#     所以这里**不再有这个键**；代码里也搜不到，回归套件
#     _test_pet_window_heal_191 第 12 节专门断言它没被误加回来。
#     别再照抄网上/旧笔记里的 PRTS_PET_COLORKEY=1 —— 设了也没用（没人读）。

# ---- 形象窗口 WS_EX_COMPOSITED（★ 实测会把分层窗口弄坏，保持 0）----
#   1 = 开（会让 UpdateLayeredWindow 报"参数错误"、形象永久不可见，别开）
#   0 = 关（默认）
PRTS_PET_COMPOSITED=0
